{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "oxlint --max-warnings 0 .",
    "lint:fix": "oxlint --fix --max-warnings 0 .",
    "check-types": "next typegen && tsc --noEmit",
    "characters:generate": "node scripts/generate-character.mjs && oxfmt --config ../../packages/format-config/react.js --write shared/ui/character/character.generated.ts"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "gsap": "^3.15.0",
    "lucide-react": "1.8.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.1",
    "@repo/lint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@shikijs/rehype": "4.5.0",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/hast": "3.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "playwright": "1.64.1",
    "postcss": "8.5.23",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.2",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  }
