{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "warn",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-sync-scripts": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["packages/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "rules": {
        "nextjs/no-assign-module-variable": "off",
        "nextjs/no-html-link-for-pages": "off",
        "nextjs/no-sync-scripts": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".codex/**",
    ".claude/**",
    ".agents/**",
    "**/.next/**",
    "out/**",
    "build/**",
    "**/storybook-static/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "**/next-env.d.ts",
    "packages/cli/dist/**",
    "packages/cli/.build/**",
    "packages/cli/templates/**",
    "artifacts/**"
  ]
}
